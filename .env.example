# RED PLANET LAB - Environment Configuration

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Storage and Directories (relative to project root or absolute paths)
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_CACHE_DIR=./data/cache
DATA_METADATA_DIR=./data/metadata

# Resource and Download Limits
MAX_SECTOR_DOWNLOAD_MB=500
MAX_CACHE_TOTAL_MB=2048
REQUEST_TIMEOUT_SECONDS=30
MAX_DOWNLOAD_RETRIES=3

# External Archive Endpoints (PDS, ODE, Mars Trek)
ODE_API_BASE_URL=https://ode.rsl.wustl.edu/mars2/api/v1
MARS_TREK_WMTS_BASE_URL=https://trek.nasa.gov/tiles/Mars/EQ/
